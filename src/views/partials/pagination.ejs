<% if (pages > 1) { %>
<nav class="mt-4 d-flex justify-content-center">
  <ul class="pagination mb-0">
    <% for (let i = 1; i <= pages; i++) { %>
      <li class="page-item <%= i === page ? 'active' : '' %>">
        <a class="page-link" href="?<%= qs({ q, category, sort, page: i }) %>"><%= i %></a>
      </li>
    <% } %>
  </ul>
</nav>
<% } %>
